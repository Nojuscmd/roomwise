{
  "expo": {
    "name": "Roomwise",
    "slug": "roomwise",
    "version": "0.1.0",
    "scheme": "roomwise",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Roomwise needs the camera to photograph your room.",
          "photosPermission": "Roomwise needs photo access to analyze your room."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.roomwise"
    },
    "android": {
      "package": "com.example.roomwise",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca3ad9dc-63f3-4443-8d05-7cabf9617b25"
      }
    },
    "owner": "nojuscmd",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca3ad9dc-63f3-4443-8d05-7cabf9617b25"
    }
  }
}
